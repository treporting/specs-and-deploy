{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/specs-and-deploy/schemas/documents.schema.json",
  "$comment": "@refines ARC_22@2.1.1",
  "title": "Every Markdown file, with its type, level and version",
  "type": "object",
  "required": [
    "schema",
    "type",
    "documents"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "schemas/documents.schema.json",
      "description": "the schema of this file, from the root of the repo (formats.md, section Schemas)"
    },
    "type": {
      "const": "documents",
      "description": "what this file holds (formats.md, section The head of a file)"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "type",
          "object_version",
          "object_hash",
          "status",
          "verification_method"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "type": {
              "const": "explanation"
            }
          }
        },
        "then": {
          "required": [
            "level"
          ]
        },
        "else": {
          "not": {
            "required": [
              "level"
            ]
          }
        },
        "attributes_for_version_x": [
          "object_hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^([a-z0-9-]+/)*[A-Za-z0-9-]+\\.md$",
            "description": "the path of the document from the root of the repo"
          },
          "type": {
            "enum": [
              "explanation",
              "document"
            ],
            "description": "an explanation of a level, or a document without a level (formats.md, table types)"
          },
          "level": {
            "type": "string",
            "pattern": "^(r[1-7]|n1|h[12]|tool|rules)$",
            "description": "the level an explanation explains (formats.md, section Documents)"
          },
          "object_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "x.y.z - x the content of the file, as object_hash; y the links, z every other attribute; set at the approval (traceability.md)"
          },
          "object_hash": {
            "type": "string",
            "pattern": "^([0-9a-f]{7})?$",
            "description": "the content approved: git hash-object of the file, 7 characters; set at the approval, '' before the first (traceability.md)"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review",
                "generated"
              ]
            }
          }
        }
      }
    }
  }
}
