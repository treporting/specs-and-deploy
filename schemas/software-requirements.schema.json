{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/treporting/schemas/software-requirements.schema.json",
  "title": "Software requirements of a subsystem (r5)",
  "description": "Draft until the gel schema stands (treporting/storage-edgedb#3); field names are the properties of the gel schema.",
  "type": "object",
  "required": [
    "level",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "level": {
      "const": "r5"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "component",
          "status",
          "verification_method"
        ],
        "additionalProperties": false,
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^SR-[0-9]{2}$"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^SYS-[0-9]{2}$"
            },
            "minItems": 1
          },
          "priority": {
            "enum": [
              "later"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "enum": [
              "inspection",
              "analysis",
              "demonstration",
              "test"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "why it stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
          }
        },
        "anyOf": [
          {
            "required": [
              "target_ids"
            ]
          },
          {
            "required": [
              "rationale"
            ]
          }
        ]
      }
    }
  }
}
