{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/treporting/schemas/software-requirements.schema.json",
  "$comment": "@refines ARC_22@2.1.1",
  "title": "Software requirements of a subsystem (r5)",
  "description": "Draft until the gel schema stands (treporting/storage-edgedb#3); field names are the properties of the gel schema.",
  "type": "object",
  "required": [
    "schema",
    "type",
    "level",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "schemas/software-requirements.schema.json",
      "description": "the schema of this file, from the root of the repo (formats.md, section Schemas)"
    },
    "type": {
      "const": "requirements",
      "description": "what this file holds (formats.md, section The head of a file)"
    },
    "level": {
      "const": "r5"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "component",
          "status",
          "verification_method",
          "object_version",
          "priority",
          "safety"
        ],
        "additionalProperties": false,
        "attributes_for_version_x": [
          "object_text",
          "safety"
        ],
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^SR_[0-9]{2}$"
          },
          "object_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(SYS|TOOL)_[0-9]{2}@[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "minItems": 1
          },
          "priority": {
            "type": "string"
          },
          "safety": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review"
              ]
            },
            "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "why it stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
          }
        },
        "anyOf": [
          {
            "required": [
              "source_ids"
            ]
          },
          {
            "required": [
              "rationale"
            ]
          }
        ]
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "object_version",
          "object_hash",
          "status",
          "verification_method"
        ],
        "additionalProperties": false,
        "attributes_for_version_x": [
          "object_hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^([a-z0-9-]+/)*[A-Za-z0-9-]+\\.md$"
          },
          "object_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "x.y.z - x the content of the file, as object_hash; y the links, z every other attribute; set at the approval (traceability.md)"
          },
          "object_hash": {
            "type": "string",
            "pattern": "^([0-9a-f]{7})?$",
            "description": "the content approved: git hash-object of the file, 7 characters; set at the approval, '' before the first (traceability.md)"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review"
              ]
            }
          }
        }
      },
      "description": "the documents beside this file that explain it, each with a status of its own"
    }
  }
}
