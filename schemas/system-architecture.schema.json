{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/treporting/schemas/system-architecture.schema.json",
  "$comment": "@refines ARC_22@2.1.1",
  "title": "System architecture (r3) with the allocation (r4)",
  "description": "Draft until the gel schema stands (treporting/storage-edgedb#3); field names are the properties of the gel schema.",
  "type": "object",
  "required": [
    "schema",
    "type",
    "level",
    "elements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "schemas/system-architecture.schema.json",
      "description": "the schema of this file, from the root of the repo (formats.md, section Schemas)"
    },
    "type": {
      "const": "architecture",
      "description": "what this file holds (formats.md, section The head of a file)"
    },
    "level": {
      "const": "r3"
    },
    "elements": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "object_key",
              "object_text",
              "kind",
              "repo",
              "status",
              "verification_method",
              "object_version",
              "priority",
              "safety"
            ],
            "additionalProperties": false,
            "attributes_for_version_x": [
              "object_text",
              "safety"
            ],
            "properties": {
              "object_key": {
                "type": "string",
                "pattern": "^ARC_0[0-9]$"
              },
              "object_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
              },
              "object_text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "subsystem"
              },
              "repo": {
                "type": "string",
                "minLength": 1
              },
              "allocated": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SYS_[0-9]{2}@[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              },
              "priority": {
                "type": "string"
              },
              "safety": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "review",
                  "approved",
                  "obsolete"
                ]
              },
              "verification_method": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "inspection",
                    "analysis",
                    "demonstration",
                    "test",
                    "review"
                  ]
                },
                "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "why it stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
              }
            },
            "anyOf": [
              {
                "required": [
                  "allocated"
                ]
              },
              {
                "required": [
                  "rationale"
                ]
              }
            ]
          },
          {
            "type": "object",
            "required": [
              "object_key",
              "object_text",
              "kind",
              "between",
              "status",
              "verification_method",
              "object_version",
              "priority",
              "safety"
            ],
            "additionalProperties": false,
            "attributes_for_version_x": [
              "object_text",
              "safety"
            ],
            "properties": {
              "object_key": {
                "type": "string",
                "pattern": "^ARC_[1-9][0-9]$"
              },
              "object_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
              },
              "object_text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "interface"
              },
              "between": {
                "type": "string",
                "minLength": 1
              },
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "type": "string"
              },
              "safety": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "review",
                  "approved",
                  "obsolete"
                ]
              },
              "verification_method": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "inspection",
                    "analysis",
                    "demonstration",
                    "test",
                    "review"
                  ]
                },
                "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "why it stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "object_key",
              "object_text",
              "kind",
              "contract",
              "status",
              "verification_method",
              "object_version",
              "priority",
              "safety"
            ],
            "additionalProperties": false,
            "attributes_for_version_x": [
              "object_text",
              "safety"
            ],
            "properties": {
              "object_key": {
                "type": "string",
                "pattern": "^ARC_[1-9][0-9]$"
              },
              "object_version": {
                "type": "string",
                "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
                "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
              },
              "object_text": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "const": "model"
              },
              "contract": {
                "type": "string",
                "minLength": 1
              },
              "allocated": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^SYS_[0-9]{2}@[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              },
              "priority": {
                "type": "string"
              },
              "safety": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "draft",
                  "review",
                  "approved",
                  "obsolete"
                ]
              },
              "verification_method": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "inspection",
                    "analysis",
                    "demonstration",
                    "test",
                    "review"
                  ]
                },
                "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "description": "why it stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
              }
            },
            "anyOf": [
              {
                "required": [
                  "allocated"
                ]
              },
              {
                "required": [
                  "rationale"
                ]
              }
            ]
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "object_version"
        ],
        "additionalProperties": false,
        "attributes_for_version_x": [
          "object_text"
        ],
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^ARC[RD]_[0-9]{2}$"
          },
          "object_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "object_version",
          "object_hash",
          "status",
          "verification_method"
        ],
        "additionalProperties": false,
        "attributes_for_version_x": [
          "object_hash"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^([a-z0-9-]+/)*[A-Za-z0-9-]+\\.md$"
          },
          "object_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "x.y.z - x the content of the file, as object_hash; y the links, z every other attribute; set at the approval (traceability.md)"
          },
          "object_hash": {
            "type": "string",
            "pattern": "^([0-9a-f]{7})?$",
            "description": "the content approved: git hash-object of the file, 7 characters; set at the approval, '' before the first (traceability.md)"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review"
              ]
            }
          }
        }
      },
      "description": "the documents beside this file that explain it, each with a status of its own"
    }
  }
}
