{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/specs-and-deploy/schemas/tool-requirements.schema.json",
  "title": "Tool requirements",
  "description": "The requirements on the tools of our work; tools are code (devops.md).",
  "type": "object",
  "required": [
    "level",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "level": {
      "const": "tool"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "feature",
          "status",
          "verification_method"
        ],
        "additionalProperties": false,
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^TOOL-[0-9]{2}$"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "target_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^(PROC|REG)-[0-9]{2}$"
            }
          },
          "priority": {
            "enum": [
              "later"
            ]
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review"
              ]
            },
            "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC-13)"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "why it stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
          }
        },
        "anyOf": [
          {
            "required": [
              "target_ids"
            ]
          },
          {
            "required": [
              "rationale"
            ]
          }
        ]
      }
    }
  }
}
