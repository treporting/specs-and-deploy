{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/treporting/schemas/system-requirements.schema.json",
  "title": "System requirements (r2)",
  "description": "Draft until the gel schema stands (treporting/storage-edgedb#3); field names are the properties of the gel schema.",
  "type": "object",
  "required": [
    "level",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "level": {
      "const": "r2"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "feature",
          "status",
          "verification_method",
          "platform_launch"
        ],
        "additionalProperties": false,
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^SYS-[0-9]{2}$"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(UN-[A-Z]+|REG|HAZC|THRC)-[0-9]{2}$|^ARC-D[0-9]{2}$"
            },
            "minItems": 1
          },
          "priority": {
            "enum": [
              "later"
            ]
          },
          "measured": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "enum": [
              "inspection",
              "analysis",
              "demonstration",
              "test"
            ]
          },
          "platform_launch": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "why the requirement stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
          }
        },
        "anyOf": [
          {
            "required": [
              "target_ids"
            ]
          },
          {
            "required": [
              "rationale"
            ]
          }
        ]
      }
    }
  }
}
