{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/treporting/schemas/system-requirements.schema.json",
  "$comment": "@refines ARC_22@2.1.1",
  "title": "System requirements (r2)",
  "description": "Draft until the gel schema stands (treporting/storage-edgedb#3); field names are the properties of the gel schema.",
  "type": "object",
  "required": [
    "schema",
    "type",
    "level",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "schemas/system-requirements.schema.json",
      "description": "the schema of this file, from the root of the repo (formats.md, section Schemas)"
    },
    "type": {
      "const": "requirements",
      "description": "what this file holds (formats.md, section The head of a file)"
    },
    "level": {
      "const": "r2"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "feature",
          "status",
          "verification_method",
          "platform_launch",
          "object_version",
          "priority",
          "safety"
        ],
        "additionalProperties": false,
        "attributes_for_version_x": [
          "object_text",
          "safety"
        ],
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^SYS_[0-9]{2}$"
          },
          "object_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "description": "x.y.z - x the text and the attributes for x, y the links, z every other attribute; set at the approval (traceability.md)"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(UN_[A-Z]+|HAZC|THRC)_[0-9]{2}@[0-9]+\\.[0-9]+\\.[0-9]+$|^REG_[A-Za-z0-9-]+_[0-9]{2}@[0-9]+\\.[0-9]+\\.[0-9]+$|^ARCD_[0-9]{2}@[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "minItems": 1
          },
          "measured": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "priority": {
            "type": "string"
          },
          "safety": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review"
              ]
            },
            "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC_13)"
          },
          "platform_launch": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "why the requirement stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
          }
        },
        "anyOf": [
          {
            "required": [
              "source_ids"
            ]
          },
          {
            "required": [
              "rationale"
            ]
          }
        ]
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^([a-z0-9-]+/)*[A-Za-z0-9-]+\\.md$"
      },
      "description": "the Markdown files that explain this level, by their path from the root; their versions stand in documents.yaml (formats.md, section Documents)"
    }
  }
}
