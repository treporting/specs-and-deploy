{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/treporting/schemas/system-requirements.schema.json",
  "title": "System requirements (r2)",
  "description": "Draft until the gel schema stands (treporting/storage-edgedb#3); field names are the properties of the gel schema.",
  "type": "object",
  "required": [
    "level",
    "requirements"
  ],
  "additionalProperties": false,
  "properties": {
    "level": {
      "const": "r2"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "object_text",
          "feature",
          "status",
          "verification_method",
          "platform_launch"
        ],
        "additionalProperties": false,
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^SYS-[0-9]{2}$"
          },
          "object_text": {
            "type": "string",
            "minLength": 1
          },
          "feature": {
            "type": "string",
            "minLength": 1
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(UN-[A-Z]+|REG|HAZC|THRC)-[0-9]{2}$|^ARC-D[0-9]{2}$"
            },
            "minItems": 1
          },
          "priority": {
            "enum": [
              "later"
            ]
          },
          "measured": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review"
              ]
            },
            "description": "how a requirement is verified: inspection, analysis, demonstration, test after ISO/IEC/IEEE 29148; review - our own value - by the review against the criteria of its level (PROC-13)"
          },
          "platform_launch": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "description": "why the requirement stands, where it names no uplink (ISO/IEC/IEEE 29148, 5.2.8)"
          }
        },
        "anyOf": [
          {
            "required": [
              "target_ids"
            ]
          },
          {
            "required": [
              "rationale"
            ]
          }
        ]
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "status",
          "verification_method"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^([a-z0-9-]+/)*[A-Za-z0-9-]+\\.md$"
          },
          "status": {
            "enum": [
              "draft",
              "review",
              "approved",
              "obsolete"
            ]
          },
          "verification_method": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "inspection",
                "analysis",
                "demonstration",
                "test",
                "review"
              ]
            }
          }
        }
      },
      "description": "the documents beside this file that explain it, each with a status of its own"
    }
  }
}
