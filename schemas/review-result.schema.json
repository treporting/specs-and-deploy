{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/treporting/specs-and-deploy/schemas/review-result.schema.json",
  "$comment": "@refines ARC_22@2.1.1",
  "title": "Review results (RR) of one review",
  "description": "One file is one review: who, when, against which criteria; one result per requirement reviewed. Checked beyond the schema by the CI: every criterion of the criteria file appears once; the reviewer is not the author of the requirement (PROC_15).",
  "type": "object",
  "required": [
    "schema",
    "level",
    "created_by",
    "created_at",
    "criteria",
    "criteria_revision",
    "results"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "schemas/review-result.schema.json",
      "description": "the schema of this file, from the root of the repo (formats.md, section Schemas)"
    },
    "level": {
      "const": "review"
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "criteria": {
      "type": "string",
      "pattern": "^reviews/criteria-[a-z0-9]+\\.yaml$"
    },
    "criteria_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "object_key",
          "target_ids",
          "revision",
          "criteria",
          "verdict"
        ],
        "additionalProperties": false,
        "properties": {
          "object_key": {
            "type": "string",
            "pattern": "^RR-[0-9]{2}$"
          },
          "target_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "revision": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          },
          "criteria": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "pattern": "^RC-[0-9]{2}$"
            },
            "additionalProperties": {
              "oneOf": [
                {
                  "const": "passed"
                },
                {
                  "type": "object",
                  "required": [
                    "result",
                    "note"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "result": {
                      "enum": [
                        "passed",
                        "failed"
                      ]
                    },
                    "note": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          },
          "verdict": {
            "enum": [
              "passed",
              "failed"
            ]
          }
        },
        "if": {
          "properties": {
            "verdict": {
              "const": "passed"
            }
          }
        },
        "then": {
          "properties": {
            "criteria": {
              "additionalProperties": {
                "oneOf": [
                  {
                    "const": "passed"
                  },
                  {
                    "type": "object",
                    "properties": {
                      "result": {
                        "const": "passed"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
